rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Pas de Cloud Functions (plan Spark) : le rôle vit uniquement dans le document
    // users/{uid}, jamais dans un custom claim. Toute lecture de données sensibles exige
    // donc un profil existant — un compte Auth auto-créé sans profil (cf. limite ci-dessous)
    // n'a accès à rien.

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Un profil désactivé (active == false) compte comme "pas de profil" : la personne garde son
    // compte Authentication (son nom reste sur ses appels passés) mais perd tout accès aux
    // données dès que ses règles sont évaluées — sans avoir besoin de désactiver son compte
    // Authentication lui-même (ce qui exigerait l'Admin SDK, donc une Cloud Function).
    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    function isAdmin() {
      return hasProfile() && myProfile().role == 'admin';
    }

    // Adresse e-mail Google de l'utilisateur connecté, normalisée en minuscules — c'est aussi
    // l'ID des documents invitations/{email}, ce qui permet à une personne invitée de lire/récla-
    // mer uniquement SON invitation.
    function myEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function invitationFor(email) {
      return get(/databases/$(database)/documents/invitations/$(email)).data;
    }

    // --- Fenêtre de modification d'un appel (correction ou suppression douce) ---
    // Passé ce délai depuis la date de la séance (pas la date de saisie), seul un admin peut
    // encore corriger ou supprimer l'appel ; l'auteur seul ne le peut plus.
    function recordSessionDate(data) {
      let parts = data.date.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    function withinEditWindow(data) {
      return request.time < recordSessionDate(data) + duration.value(7, 'd');
    }

    function canModifyRecord(data) {
      return isAdmin() || (data.authorId == request.auth.uid && withinEditWindow(data));
    }

    // --- Invitations en attente ---
    // Un admin invite une personne par e-mail (ID du document = e-mail en minuscules) sans jamais
    // créer de compte Authentication ni envoyer de mail : aucune adresse Gmail requise, aucun
    // problème de délivrabilité. La personne invitée réclame son invitation elle-même à sa
    // première connexion avec "Se connecter avec Google" (cf. claimInvitation dans
    // src/lib/users.js), ce qui crée son profil users/{uid} puis supprime l'invitation.
    match /invitations/{email} {
      allow read, delete: if isAdmin() || myEmail() == email;
      allow create, update: if isAdmin() &&
        request.resource.data.role in ['admin', 'teacher'] &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'classIds', 'subjectIds']);
    }

    // --- Comptes enseignants / admins ---
    match /users/{uid} {
      allow read: if hasProfile();
      // Deux façons de créer un profil :
      // - un admin le crée directement (rare désormais, cf. scripts) ;
      // - la personne invitée réclame elle-même son invitation à sa première connexion Google :
      //   les champs écrits doivent correspondre exactement à ceux de son invitation, pour
      //   qu'elle ne puisse pas s'auto-attribuer un rôle ou des affectations différents.
      allow create: if (
        isAdmin() &&
        request.resource.data.role in ['admin', 'teacher'] &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'classIds', 'subjectIds', 'active'])
      ) || (
        request.auth.uid == uid && myEmail() != '' &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/invitations/$(myEmail())) &&
        request.resource.data.displayName == invitationFor(myEmail()).displayName &&
        request.resource.data.email == invitationFor(myEmail()).email &&
        request.resource.data.role == invitationFor(myEmail()).role &&
        request.resource.data.classIds == invitationFor(myEmail()).classIds &&
        request.resource.data.subjectIds == invitationFor(myEmail()).subjectIds &&
        request.resource.data.active == true
      );
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classIds', 'subjectIds', 'role', 'active']);
      allow delete: if false;
    }

    // --- Classes ---
    match /classes/{classId} {
      allow read: if hasProfile();
      allow create, update: if isAdmin();
      allow delete: if false; // archivage via update(archived:true), pas de suppression définitive
    }

    // --- Matières ---
    match /subjects/{subjectId} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    // --- Élèves ---
    // La suppression définitive est réservée à la correction d'erreurs de saisie (l'UI recommande
    // markStudentDeparted pour un départ réel, qui préserve l'historique des appels passés).
    match /students/{studentId} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    // --- Créneaux horaires ---
    match /timeSlots/{slotId} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }

    // --- Réglages généraux (ex. seuil de présence) ---
    match /settings/{docId} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    // --- Appels ---
    // Un appel n'est jamais recréé : l'ID déterministe (date_classe_matière_créneau) fait que
    // Firestore refuse nativement toute tentative de "create" sur un document déjà existant —
    // c'est ce qui garantit l'unicité d'un appel, sans transaction serveur.
    // Une fois créé, l'auteur peut corriger son propre appel ; un admin peut corriger n'importe
    // lequel (motif obligatoire conservé dans tous les cas).
    match /attendanceRecords/{recordId} {
      allow read: if hasProfile();
      allow create: if hasProfile() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName == myProfile().displayName &&
        request.resource.data.locked == true &&
        request.resource.data.corrections.size() == 0;
      // Deux formes de modification, toutes deux réservées à l'auteur (dans les 7 jours suivant la
      // séance) ou à un admin (sans limite de temps), et jamais sur un appel déjà supprimé :
      // - correction : entries + une nouvelle correction tracée ;
      // - suppression douce : le document n'est jamais réellement effacé (cf. allow delete ci-
      //   dessous), il est marqué deleted=true avec son propre motif tracé, pour rester visible
      //   dans le registre.
      allow update: if resource.data.get('deleted', false) != true && canModifyRecord(resource.data) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries', 'corrections']) &&
          request.resource.data.corrections.size() == resource.data.corrections.size() + 1
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deletedByName', 'deletedReason']) &&
          request.resource.data.get('deleted', false) == true
        )
      );
      allow delete: if false;
    }
  }
}
